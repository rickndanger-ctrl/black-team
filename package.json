{
  "name": "black-team",
  "productName": "Black Team",
  "description": "Local AI model harness for Linux with a private phone companion",
  "version": "0.1.0-alpha.8",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "main.cjs",
  "scripts": {
    "build": "vite build",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs && python3 -m unittest discover -s tests -p '*_test.py' -v",
