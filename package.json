    "package:linux": "python3 scripts/package.py",
    "prestart": "npm run build"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}
